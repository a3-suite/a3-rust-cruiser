## 公開スキルのデプロイ先（任意・絶対パス・未利用先は空欄）
# 追加保護は .agents/skill-deploy.yml の targets で指定する。
# 例: SKILLS_CODEX_DIR=/home/you/.codex/skills
SKILLS_CODEX_DIR=
# 例: SKILLS_CLAUDE_DIR=/home/you/.claude/skills
SKILLS_CLAUDE_DIR=
# 例: SKILLS_GEMINI_DIR=/home/you/.gemini/skills
SKILLS_GEMINI_DIR=
# 例: SKILLS_COPILOT_DIR=/home/you/project/.github/skills
SKILLS_COPILOT_DIR=
# 複数のハーネスが共通に読むスキル置き場。例: SKILLS_AGENTS_DIR=/home/you/.agents/skills
SKILLS_AGENTS_DIR=
