{
  "schemaVersion": "installer.manifest.v2",
  "releaseVersion": "<release-version>",
  "targetPlatformId": "<target-platform-id>",
  "source": {
    "kind": "github-release",
    "owner": "<repository-owner>",
    "repository": "<repository-name>",
    "fixedReference": "<release-tag>"
  },
  "artifact": {
    "url": "<fixed-release-asset-url>",
    "fileName": "<artifact-file-name>",
    "checksum": "sha256:<artifact-sha256>"
  },
  "placement": {
    "managedRoot": "~/.local/share/a3-suite/a3-rust-cruiser/standalone",
    "releasePath": "~/.local/share/a3-suite/a3-rust-cruiser/standalone/releases/0.2.0",
    "currentLink": "~/.local/share/a3-suite/a3-rust-cruiser/standalone/current",
    "profile": "per-user-cli",
    "channel": "standalone"
  },
  "activation": {
    "strategy": "active-pointer",
    "launcherPath": "~/.local/bin/a3-rust-cruiser"
  },
  "concurrency": {
    "lockPath": "~/.local/share/a3-suite/a3-rust-cruiser/standalone/install.lock"
  },
  "state": {
    "installStatePath": "~/.local/share/a3-suite/a3-rust-cruiser/standalone/state/install-state.json"
  },
  "compatibility": {
    "requiredInstallerVersion": "2"
  },
  "provenance": {
    "sourceTag": "<release-tag>",
    "sourceCommit": "<source-commit-sha>",
    "ciRunId": "<ci-run-or-assembly-id>"
  }
}
